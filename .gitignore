/phpcs.xml
/phpstan.neon
/phpunit.xml

# Ignore Drupal scaffold.
/.editorconfig
/.gitattributes

# Ignore CI.
/.editorconfig
/.gitattributes

# Node Modules #
node_modules

# OS generated files #
.DS_Store

# Ignore ddev Solr config
/.ddev/solr/conf

# Ignore sql dump.
*.sql
*.sql.gz

